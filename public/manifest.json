{
  "manifest_version": 3,
  "name": "ZeroPin - Highlight anything, Save, Done - AI Summaries/Reminders",
  "version": "0.5.0",
  "description": "Save pages, snippets & AI answers to a private library. Highlights saved text on revisit. AI to summarize your bookmarks/snippets. Tags, folders, reminders & command palette",
  "permissions": ["contextMenus", "storage", "tabs", "activeTab", "clipboardWrite", "alarms", "notifications", "tts"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "index.html"
  },
  "commands": {
    "pin-it": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "Command+Shift+P" },
      "description": "Pin selection or page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
